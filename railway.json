{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "uvicorn src.api.enhanced_main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "variables": {
        "ENV": "production",
        "LOG_LEVEL": "INFO",
        "PYTHONPATH": "/app",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "regions": ["us-west1"],
  "services": [
    {
      "name": "dabs-backend",
      "source": {
        "type": "github",
        "repo": "Hills-and-Hollows/dabs-automation",
        "branch": "main"
      }
    }
  ]
}
