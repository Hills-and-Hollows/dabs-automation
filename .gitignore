# DABS Automation System - Git Ignore Rules
# Utah Package Agency Liquor Inventory Management

# ============================================================================
# SENSITIVE DATA & CREDENTIALS (CRITICAL - NEVER COMMIT)
# ============================================================================
.env
.env.local
.env.production
.env.staging
.env.development
*.env

# API Keys & Credentials
config/secrets/
credentials/
*.key
*.pem
*.p12
*.crt
oauth_tokens/
quickbooks_credentials.json
sscs_api_keys.json
verifone_config.json

# Database passwords
db_config.json
database.ini

# ============================================================================
# DABS SPECIFIC DATA FILES (HIGH PRIORITY)
# ============================================================================
